PORT=5000
# Saytning manzili (bot xabarlarida havola sifatida ishlatiladi)
SITE_URL=http://localhost:5000
# Ixtiyoriy uzun tasodifiy satr
JWT_SECRET=bu-yerga-uzun-maxfiy-satr-yozing
# @BotFather dan olingan token (bo'sh qoldirilsa bot ishlamaydi)
BOT_TOKEN=
# Bot username (@ belgisisiz) — saytda "Botga o'tish" tugmasi uchun
BOT_USERNAME=
# MongoDB ulanishi (mahalliy server yoki Atlas manzili)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kamalak
